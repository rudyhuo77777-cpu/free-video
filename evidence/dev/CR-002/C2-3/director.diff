+// CR-002 (FV-010 root cause). The old upper bound of 3.6 words/second was never measured
+// against the voice that actually speaks the narration. The page concatenates every scene's
+// voice into ONE utterance (apps/web/app/video/page.tsx) and the renderer decodes the WHOLE
+// WAV, so the governing figures are multi-sentence delivery plus the silence around it.
+// Measured on 22 real local Supertonic F5 / id samples (evidence/dev/CR-002/C2-1, C2-1b and
+// the Codex audit sample): multi-sentence speech runs at 2.10-2.26 words/second, with a fixed
+// 1.33 s of leading+trailing silence that does NOT scale with word count. A purely
+// proportional budget therefore fails on short narration, which is why the overhead is
+// modelled separately. Budget = (duration - overhead) x slowest measured rate x 0.90.
+const NARRATION_FIXED_OVERHEAD_SECONDS=1.33;
+const NARRATION_WORDS_PER_SECOND=1.8925;
+export function maxNarrationWords(duration) {
+  return Math.floor((duration-NARRATION_FIXED_OVERHEAD_SECONDS)*NARRATION_WORDS_PER_SECOND);
+}
