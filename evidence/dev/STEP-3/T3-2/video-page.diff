+// FV-004: a lost completion receipt must never cost the user a second free script.
+// The pending idempotency key is kept for the exact same input, so a retry replays the job
+// the server already finished instead of starting a new one. Storage is best-effort: when
+// sessionStorage is unavailable (private mode) the previous behaviour applies unchanged.
+const PENDING_SCRIPT_JOB_KEY = 'auria.video.pendingScriptJob';
+// Errors where the server may already hold a completed result despite the failed response.
+const REPLAYABLE_SCRIPT_ERRORS = new Set(['persistence_unconfirmed', 'refund_pending_recovery']);
+
+function readPendingScriptJob(): { key: string; fingerprint: string } | null {
+  try {
+    const raw = sessionStorage.getItem(PENDING_SCRIPT_JOB_KEY);
+    if (!raw) return null;
+    const value = JSON.parse(raw);
+    return typeof value?.key === 'string' && typeof value?.fingerprint === 'string'
+      ? { key: value.key, fingerprint: value.fingerprint }
+      : null;
+  } catch { return null; }
+}
+
+function writePendingScriptJob(value: { key: string; fingerprint: string } | null) {
+  try {
+    if (value) sessionStorage.setItem(PENDING_SCRIPT_JOB_KEY, JSON.stringify(value));
+    else sessionStorage.removeItem(PENDING_SCRIPT_JOB_KEY);
+  } catch { /* best effort only; never block rendering */ }
+}
+
+async function replayCompletedScriptJob(key: string): Promise<DirectorJson | null> {
+  try {
+    const res = await fetch(`/api/scripts/jobs/${encodeURIComponent(key)}`, { cache: 'no-store' });
+    if (!res.ok) return null;
+    const state = await res.json();
+    return state?.status === 'completed' && state.result ? state.result as DirectorJson : null;
+  } catch { return null; }
+}
