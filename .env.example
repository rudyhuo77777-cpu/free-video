# Free Video Cloudflare Lite
# Cloudflare AI + D1 are bindings in wrangler.jsonc, so no AI API key, Redis or Postgres URL is required.

# Optional anti-bot protection. Leave empty for the zero-setup Lite launch.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SCRIPT_DAILY_PER_IP_LIMIT=30

# Optional stock-video providers. Leave empty to use keyless Wikimedia Commons + Openverse.
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Optional Windows Local Voice Bridge
AURIA_VOICE_BRIDGE_PORT=8787
AURIA_TTS_MAX_TEXT_CHARS=6000
AURIA_VOICE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8790,http://127.0.0.1:8790,https://freevideo.eco-velo.com
# SUPERTONIC_EXE=C:\path\to\supertonic.exe
