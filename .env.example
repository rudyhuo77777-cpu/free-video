# Examples only. CLI does NOT automatically load this file. Never commit actual secrets.
# Deployment-only, non-secret identifiers. Bind EXISTING production D1, do not create a replacement.
# CLOUDFLARE_ACCOUNT_ID=
# FREE_VIDEO_D1_ID=
# Cloudflare authentication remains in your CLI login / platform deployment environment.

# Runtime values are in wrangler.jsonc/wrangler.local.jsonc.
# AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# AI_TIMEOUT_MS=45000
# SCRIPT_DAILY_PER_IP_LIMIT=30
# Optional secrets: set using Cloudflare secrets / untracked .dev.vars for local preview.
# PIXABAY_API_KEY=
# PEXELS_API_KEY=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=  (build-time only)

# Optional local Windows voice bridge process environment:
# AURIA_VOICE_BRIDGE_PORT=8787
# AURIA_TTS_MAX_TEXT_CHARS=6000
# AURIA_VOICE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8790,http://127.0.0.1:8790,https://freevideo.eco-velo.com
# SUPERTONIC_EXE=C:\path\to\your\configured\supertonic.exe
