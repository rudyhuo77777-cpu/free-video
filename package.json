{
  "name": "free-video-cloudflare-lite",
  "version": "0.3.1",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/voice-bridge",
    "packages/core"
  ],
  "scripts": {
    "build": "npm run build -w @auria/core && npm run build -w @auria/web",
    "typecheck": "npm run build -w @auria/core && npm run typecheck -w @auria/web",
    "dev:web": "npm run build -w @auria/core && npm run dev -w @auria/web",
    "voice-bridge": "node apps/voice-bridge/server.mjs",
    "preview": "npm run build && wrangler dev --port 8790",
    "deploy": "wrangler deploy",
    "audit:lite": "node scripts/lite-audit.mjs",
    "audit:ui": "node scripts/ui-integrity.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module"
}
